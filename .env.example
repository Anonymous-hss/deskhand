# Host and local demo apps
PORT=4100
DEMO_APPS_URL=http://localhost:4000

# Switch: configure its webhook to http://<host>:4100/webhook/switch
SWITCH_SERVER_URL=http://localhost:7700
SWITCH_ROOM_ID=ops
SWITCH_AGENT_ID=deskhand-agent
SWITCH_AGENT_TOKEN=replace-with-switch-agent-token
SWITCH_MODE=stream
# Optional override for Switch SSE path (relative to SWITCH_SERVER_URL)
# SWITCH_EVENTS_PATH=/agents/deskhand-agent/events

# Generalized browsing; approvals still guard risky actions
ALLOW_ALL_DOMAINS=false
GENERALIZED_AGENT=false

# Azure: use a resource root, /openai/v1 base, or full inference endpoint
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AI_PROVIDER=azure
# Optional legacy alias for AZURE_OPENAI_API_KEY; never commit real keys
AI_API_KEY=
AI_VISION_MODEL=gpt-4o

# mock never calls the provider; live requires a valid Azure endpoint and key
VISION_MODE=mock
HARD_CALL_CAP=150
