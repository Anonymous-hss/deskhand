# Deskhand Windows Agent Host & Switch Configuration
PORT=4100
DEMO_APPS_URL=http://localhost:4000

# Switch Local Server Configuration (Ensure "Share usage data" is OFF in Switch Console)
SWITCH_SERVER_URL=http://localhost:7700
SWITCH_ROOM_ID=ops
SWITCH_AGENT_ID=deskhand-agent
SWITCH_AGENT_TOKEN=replace-with-switch-agent-token
# Set to "stream" (default SSE + 2s heartbeat) or "rest_fallback" (POST /agents/{id}/message)
SWITCH_MODE=stream

# Vision Model & Call Budget Configuration
# Set VISION_MODE=mock for 0-call testing/rehearsal, or "live" for real Vision LLM calls
VISION_MODE=mock
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-vision-api-key
AI_VISION_MODEL=gemini-2.5-flash

# Hard Call Budget Cap (Persisted on disk at ./data/call-budget.json)
HARD_CALL_CAP=150

